; ---------------------------------------------------------------
; Glass Depth - theme Windows 11
;
; Structure calquee sur %SystemRoot%\Resources\Themes\dark.theme,
; section par section, pour ne dependre d'aucune supposition.
;
; Le fond pointe vers %USERPROFILE%\Pictures : un chemin hors du
; profil utilisateur peut etre refuse silencieusement par Windows.
;
; Double-clic = applique. Pour revenir en arriere :
; Parametres > Personnalisation > Themes > choisir l'ancien.
; ---------------------------------------------------------------

[Theme]
DisplayName=Glass Depth

[Control Panel\Desktop]
Wallpaper=%USERPROFILE%\Pictures\GlassDepth\wall_depth_4k.png
TileWallpaper=0
WallpaperStyle=10
Pattern=

[Control Panel\Colors]
Background=4 6 11

[VisualStyles]
Path=%ResourceDir%\Themes\Aero\Aero.msstyles
ColorStyle=NormalColor
Size=NormalSize
AutoColorization=0
; Bleu acier, accorde a la lueur d'horizon du fond.
ColorizationColor=0XC02D6BD8
SystemMode=Dark
AppMode=Dark

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=RJSPBS
