[ext_resource type="Shader" path="res://shaders/hologram.gdshader" id="2_holo"]

; ⚠️ PALETTE — le probleme n'etait pas la luminosite mais la SATURATION.
; Tout etait en cyan pur (0, 1, 1) : la couleur la plus saturee possible
; sur un ecran, agressive par construction quelle que soit sa luminosite.
; Trois baisses de luminosite successives n'y avaient rien change.
; Palette « bleu glacier » desaturee, et surtout une HIERARCHIE DE
; VALEURS : la tete s'efface (0.12), les traits ressortent (0.26-0.30).
; Avant, tout etait a 0.18, donc rien ne se detachait — c'est ce qui
; rendait les yeux et la bouche illisibles.

[sub_resource type="ShaderMaterial" id="ShaderMat_head"]
render_priority = 0
shader = ExtResource("2_holo")
shader_parameter/surface_brightness = 0.12
shader_parameter/base_color = Color(0.35, 0.62, 0.7, 0.06)
shader_parameter/glow_color = Color(0.55, 0.85, 0.92, 1)
shader_parameter/rim_color = Color(0.75, 0.92, 0.96, 1)
shader_parameter/scanline_count = 90.0
shader_parameter/scanline_speed = 2.0
shader_parameter/fresnel_power = 2.5
shader_parameter/glitch_intensity = 0.05
shader_parameter/time_scale = 1.0
shader_parameter/pulse_speed = 1.6
shader_parameter/wireframe_intensity = 0.5

[sub_resource type="SphereMesh" id="SphereMesh_head"]
radius = 2.5
height = 5.0
radial_segments = 64
rings = 48

