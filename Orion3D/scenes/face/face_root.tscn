[node name="FaceRoot" type="Node3D"]
script = ExtResource("1_ctrl")

; ⚠️ Echelle (1.0, 1.08, 0.92) : PLUS HAUTE QUE LARGE. Une sphere
; parfaite se lit comme une balle ; un visage est plus haut que large.
; C'est l'inverse exact du 0.85 qui l'ecrasait auparavant.
; L'ellipsoide resultant : demi-axes 2.5 / 2.7 / 2.3.
[node name="Head" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1.08, 0, 0, 0, 0.92, 0, 0, 0)
mesh = SubResource("SphereMesh_head")
surface_material_override/0 = SubResource("ShaderMat_head")

; ⚠️ LES YEUX ETAIENT A L'INTERIEUR DE LA TETE. Ils etaient a z = 2.05
; alors que la surface, a x = 0.95, se trouve a z = 2.31 : on les voyait
; A TRAVERS la coque translucide, d'ou leur aspect de taches floues.
; Ce n'etait pas un manque de definition, c'etait un bug geometrique.
; Ils sont desormais poses SUR la surface (z = 2.0 pour un point de
; surface a 1.95), aplatis en lentilles (echelle z 0.35) pour epouser la
; courbure, et ECARTES de 1.9 a 2.4 — ils etaient trop rapproches.
; Ils sont freres de Head, donc l'echelle de Head ne s'applique pas a eux.
[node name="EyeLeft" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.85, 0, 0, 0, 0.35, -1.2, 0.6, 2)
mesh = SubResource("SphereMesh_eye")
surface_material_override/0 = SubResource("ShaderMat_eye")

[node name="EyeRight" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.85, 0, 0, 0, 0.35, 1.2, 0.6, 2)
mesh = SubResource("SphereMesh_eye")
surface_material_override/0 = SubResource("ShaderMat_eye")

; Bouche descendue de -0.65 a -0.9 : sur un visage, l'ecart yeux-bouche
; est bien plus grand que l'ecart yeux-sommet.
[node name="Mouth" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.9, 2.2)
mesh = SubResource("BoxMesh_mouth")
surface_material_override/0 = SubResource("ShaderMat_mouth")

