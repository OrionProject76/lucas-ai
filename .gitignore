# .gitignore — Luca's AI (ex-OrionAI)

# --- Environnement Python ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets (le modèle .env.example reste versionné) ---
.env
.env.local
!.env.example

# --- HTTPS local (mkcert) — clé privée, jamais versionnée ---
# Générés le 02/08/2026 pour le pont mobile (getUserMedia exige un
# contexte sécurisé — voir ROADMAP.md). Propres à cette machine et son
# IP réseau : aucune valeur à reconstituer ailleurs. rootCA.crt n'est
# pas un secret (clé publique), mais il est dérivé de la même CA locale
# — le laisser versionné deviendrait trompeur le jour où la CA change.
data/cert.pem
data/key.pem
static/rootCA.crt
tools/mkcert.exe

# --- Outils IA / éditeurs ---
.aider*
.vscode/
.idea/

# --- Godot : sources suivies, artefacts d'export ignorés ---
Lucas3D.exe
Lucas3D.console.exe
Lucas3D/.godot/
*.pck
export_presets.cfg

# --- Données générées (jamais de données perso dans le dépôt) ---
# Les bases SQLite contiennent les conversations et événements de Cyril :
# le code du module est versionné, jamais son contenu.
*.db
*.sqlite3
data/chromadb/
modules/data/
# Modèles de voix Piper (.onnx, ~60-75 Mo pièce) et sorties audio locales
data/voices/
data/output_piper.wav

# État de la surveillance sécurité (empreintes des signaux déjà vus)
data/security_state.json
# Mémoire des comportements observés : contient les adresses contactées
# par les programmes de Cyril, donc à ne jamais versionner.
data/security_history.json

# Relevés bancaires réels de Cyril — ne doivent JAMAIS être versionnés.
# Seul data/sample_transactions.csv (données fictives) est suivi.
data/finance/
*.ofx
*.qif
data/logs/
data/screenshots/
data/screenshot.png
data/output.mp3

# --- Sorties d'inspection ponctuelles ---
tree_output.txt
tree_clean.txt

# --- OS ---
Thumbs.db
desktop.ini
.DS_Store

# Documents personnels indexes par le RAG — jamais versionnes
data/documents/*
!data/documents/README.md
