# .env.example — modèle de configuration des secrets locaux
#
# Copier ce fichier en .env à la racine du projet, puis renseigner les
# valeurs. Le vrai .env est ignoré par git et ne doit jamais être commité.
#
#     cp .env.example .env
#
# Aucune valeur réelle ne doit figurer dans CE fichier.

# Clé API OpenAI — optionnelle, utilisée seulement par core/cloud_llm.py.
# Laisser vide pour rester en 100 % local via Ollama (voir CLAUDE.md règle 3).
OPENAI_API_KEY=
