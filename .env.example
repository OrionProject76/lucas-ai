# .env.example — modèle de configuration des secrets locaux
#
# Copier ce fichier en .env à la racine du projet, puis renseigner les
# valeurs. Le vrai .env est ignoré par git et ne doit jamais être commité.
#
#     cp .env.example .env
#
# Aucune valeur réelle ne doit figurer dans CE fichier.

# Clé API OpenAI — optionnelle, utilisée seulement par core/cloud_llm.py.
# Laisser vide pour rester en 100 % local via Ollama (voir CLAUDE.md règle 3).
OPENAI_API_KEY=

# Jeton partagé pour l'API (api/server.py) — optionnel, prérequis pour le
# pont mobile (ROADMAP.md §2, Phase 4). Laisser vide tant que API_HOST
# reste "127.0.0.1" : l'API n'exige alors aucun jeton, comme aujourd'hui.
# Ne renseigner une valeur QU'au moment de passer API_HOST à "0.0.0.0" —
# jamais l'inverse, sinon le réseau local devient lisible sans jeton entre
# les deux étapes.
API_TOKEN=
